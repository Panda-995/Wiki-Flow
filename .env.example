# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Auth.js v5
AUTH_SECRET="your-secret-key-change-in-production"
AUTH_URL="http://localhost:3000"
AUTH_RESEND_KEY="re_xxxxxxxxxxxx"

# Server-side encryption for stored SMTP credentials
ENCRYPTION_KEY="change-me-to-a-long-random-secret"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@wikiflow.dev"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed users. Production must set strong values explicitly.
ADMIN_SEED_PASSWORD="change-me-in-production"
EDITOR_SEED_PASSWORD="change-me-in-production"
